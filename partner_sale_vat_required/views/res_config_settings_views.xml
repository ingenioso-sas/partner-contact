<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form_inherit_vat_required" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.sale.vat</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
            <field name="priority" eval="50"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@id='sale_config_online_confirmation_pay']/ancestor::div[hasclass('row')][1]" position="after">
                    <h2>Configuración de Clientes</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="require_vat_for_sale"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="require_vat_for_sale"/>
                                <div class="text-muted">
                                    Solicitar identificación del cliente para confirmar ventas o facturar
                                </div>
                            </div>
                        </div>
                    </div>                    
                </xpath>
            </field>
        </record>
    </data>
</odoo>
